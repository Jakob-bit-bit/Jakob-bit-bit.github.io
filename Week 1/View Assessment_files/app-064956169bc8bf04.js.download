ss="secondary-text"\n          ng-if="::graderColumn.column.isAttendance() && graderColumn.column.summary.averageGradeForStudents">\n          <span bb-translate\n            translate-values="{percentage: graderColumn.column.summary.averageGradeForStudents}">components.directives.grade.grader-column.attendance.average</span>\n        </span>\n      </div>\n    </div>\n  </div>\n</td>\n\n<td role="cell" ng-if="!graderColumn.windowSizeService.isSmallBreakpoint()" class="tabular-cell grader-column category-inline-size gradable-item-interactive-cell-size" aria-describedby="gradable-item-header-category" aria-colindex="2"\n  tabindex="-1">\n  <span ng-if="!!graderColumn.column.gradebookCategory && !graderColumn.column.gradebookCategory.isUserDefined"\n    bb-translate\n    title="{{graderColumn.column.gradebookCategory.localizableTitle.languageKey}}">{{graderColumn.column.gradebookCategory.localizableTitle.languageKey}}</span>\n  <span ng-if="!graderColumn.column.gradebookCategory" bb-translate>NoCategory.name</span>\n  <span class="ellipsis" ng-if="graderColumn.column.gradebookCategory.isUserDefined" bb-translate\n    title="{{graderColumn.column.gradebookCategory.localizableTitle.languageKey}}">{{graderColumn.column.gradebookCategory.title}}</span>\n</td>\n\n<td role="cell" ng-if="!graderColumn.windowSizeService.isSmallBreakpoint()" class="tabular-cell category-inline-size gradable-item-interactive-cell-size" aria-describedby="gradable-item-header-dueDate"\n  aria-colindex="3" tabindex="-1">\n  <div ng-if="graderColumn.isCourseView">\n    <bb-datetime ng-if="!graderColumn.column.isAttendance()" format="Short" value="graderColumn.column.dueDate">\n    </bb-datetime>\n    <span ng-if="graderColumn.column.isAttendance()"\n      bb-translate>components.directives.grade.grader-column.attendance.ongoing</span>\n  </div>\n</td>\n\n<td role="cell" class="tabular-cell grader-column category-inline-size gradable-item-interactive-cell-size"\n  aria-describedby="gradable-item-header-status" aria-colindex="4" tabindex="-1">\n  <div class="grade-progress" ng-class="{\'course-only-grade-status\': graderColumn.isCourseView}"\n    ng-if="!graderColumn.column.isAttendance()">\n    <div ng-switch="graderColumn.column.isCollectExternalSubmissions()">\n      \x3c!-- External submission statuses are calculated differently from others since the instructor is initiating the attempt\n      when they go to grade the user. Therefore, we want to include people who have no submission as ready to be graded //--\x3e\n      <div ng-switch-when="true">\n        <a ng-switch="graderColumn.column.summary.getStatus().toString()"\n          ng-class="{\'submission-nav-link\': graderColumn.itemLinkIsClickable}"\n          ng-click="graderColumn.handleColumnClick(\'status\')" href="javascript:void(0);"\n          analytics-id="components.directives.grade.graderColumn.status.link"\n          tabindex="{{ graderColumn.itemLinkIsClickable ? 0 : -1 }}"\n          aria-labelledby="{{ graderColumn.itemLinkIsClickable ? graderColumn.gradingStatusAriaLabel(graderColumn.index) : undefined}}">\n          <div class="grade-count" ng-switch-when="NEEDS_GRADING">\n            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}" bb-translate\n              translate-values="{count: graderColumn.getNumberEligibleToBeGradedExternalSubmissions()}">\n              components.directives.grade.grader-column.statuses.numToGrade.plural\n            </span>\n          </div>\n          <span ng-switch-when="NEEDS_POSTING">\n            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}" bb-translate\n              ng-if="graderColumn.getNumberEligibleToBeGradedExternalSubmissions() === 0">\n              components.directives.grade.grader-column.statuses.allGraded\n            </span>\n            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}" bb-translate\n              ng-if="graderColumn.getNumberEligibleToBeGradedExternalSubmiss